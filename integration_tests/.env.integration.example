# Copy to .env.integration (ignored by Git) and source it in your shell.
# Supported targets: sandbox, dev, production-read-only.
FINGER_TRADER_IT_ENABLED=0
FINGER_TRADER_IT_TARGET=production-read-only
FINGER_TRADER_IT_CONFIRM_NON_PROD=NO
FINGER_TRADER_IT_CONFIRM_PRODUCTION_READ_ONLY=NO

# Supply the complete service URLs. HTTPS/WSS with normal TLS verification is required.
FINGER_TRADER_IT_API_BASE_URL=https://prod-api.example.invalid/finger-bff-app
FINGER_TRADER_IT_AUTH_URL=https://prod-api.example.invalid/finger-auth
FINGER_TRADER_IT_SOCKET_AUTH_URL=https://prod-api.example.invalid/finger-bff-socket

# token mode uses a user-provided short-lived token.
FINGER_TRADER_IT_AUTH_MODE=token
FINGER_TRADER_IT_ACCESS_TOKEN=replace-with-short-lived-token

# Alternatively set FINGER_TRADER_IT_AUTH_MODE=password and provide all values:
# FINGER_TRADER_IT_OAUTH_BASIC_TOKEN=operator-provided-basic-value-without-prefix
# FINGER_TRADER_IT_USERNAME=replace-with-test-username
# FINGER_TRADER_IT_PASSWORD=replace-with-test-password
# FINGER_TRADER_IT_LOGIN_TYPE=replace-with-server-login-enum
# FINGER_TRADER_IT_CAPTCHA_ID=
# FINGER_TRADER_IT_CAPTCHA_CODE=

FINGER_TRADER_IT_MARKET=stock
FINGER_TRADER_IT_TICKER=replace-with-valid-ticker
FINGER_TRADER_IT_INTERVAL=replace-with-supported-interval
FINGER_TRADER_IT_ACCOUNT_MARKET=replace-with-server-market-enum
FINGER_TRADER_IT_POSITION_IS_USD=false
FINGER_TRADER_IT_POSITION_TYPE=0
FINGER_TRADER_IT_TIMEOUT=20
